# ---------------------------------------------------------------------------
# Dream Spot Global — environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

DJANGO_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://dreamspotglobal.com,https://www.dreamspotglobal.com

# --- Database ---------------------------------------------------------------
# Leave POSTGRES_DB empty to use SQLite (development default).
POSTGRES_DB=
POSTGRES_USER=dreamspot
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email (SRS INT-01) -----------------------------------------------------
# Development prints emails to the console. In production use a domain sender
# (e.g. info@dreamspotglobal.com) with SendGrid, Mailgun or Amazon SES —
# a free Gmail address will hurt deliverability and may be marked as spam.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Dream Spot Global <info@dreamspotglobal.com>
NOTIFY_EMAILS=dreamspotglobal@gmail.com

# --- Analytics & anti-spam (SRS INT-12) -------------------------------------
GA4_MEASUREMENT_ID=
GTM_ID=
META_PIXEL_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- SMS (optional, SRS INT-04) ---------------------------------------------
SMS_API_KEY=
SMS_SENDER_ID=DreamSpot

# --- Cache / queue ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
